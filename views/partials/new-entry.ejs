  <textarea id="new-entry" name="entry" 
    placeholder="Write a new entry here. Markdown is supported"
    wrap="soft"
    cols="100" rows="10"></textarea>
  <br>
    <br>
  <input type="submit" value="Submit" id="submit_button">
</form> 
<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title>Calendar</title>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel='stylesheet' type='text/css' media='screen' href='/main.css'>
</head>
<body>
<div class="container">
    <div class="item-container" id="calendar">
        <h1>Register</h1>
        <form action="/register" method="post">
            <label for="username" style="visibility: hidden;">Enter username</label>
            <p>Username <input type="text" value="" id="username-input"></input>
            </p>
            <p>Password <input type="password" id="password" ></input></p>
            <input type="submit" value="Register" id="submit-button">
        </form>
    </div>
    
</div>

</body>
</html>